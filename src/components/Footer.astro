---
import site from '../site.config.ts';
import { url } from '../lib/url.ts';
const year = new Date().getFullYear();
const links = [
  { href: url('about/'), label: 'About' },
  { href: url('contact/'), label: 'Contact' },
  { href: url('privacy/'), label: 'Privacy Policy' },
  { href: url('terms/'), label: 'Terms' },
];
---
<footer class="mt-24 border-t border-line">
  <div class="mx-auto flex max-w-5xl flex-col gap-6 px-4 py-10 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-muted">&copy; {year} {site.name}. Free to use.</p>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {links.map((l) => <a href={l.href} class="py-2 text-muted underline-offset-4 hover:text-ink hover:underline">{l.label}</a>)}
    </nav>
  </div>
</footer>
