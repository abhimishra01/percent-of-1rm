---
// Percent of 1RM calculator UI. Logic lives in src/lib/percent.js and src/lib/render.js (tested by npm test).
import { DEFAULT_PLATES, PLATES, chart, repTable, smallestOf } from '../lib/percent.js';
import { chartRowsHtml, repRowsHtml } from '../lib/render.js';

// The default tables (225 lb, 45 lb bar, 85% marked) are in the HTML, so the page does not jump when the script starts.
const plates = DEFAULT_PLATES.lb;
const start = { oneRm: 225, bar: 45, smallest: smallestOf(plates), plates };
const startChart = chartRowsHtml(chart({ ...start, step: 5 }), 45, 85);
const startReps = repRowsHtml(repTable(start), 45);
const numberBox = 'num rounded-xl border border-edge bg-paper px-3 text-center font-mono font-bold tabular-nums outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 aria-[invalid=true]:border-red-600';
---
<section id="tool" aria-label="Percent of 1RM calculator" class="rounded-2xl border border-line bg-card p-4 sm:p-6">
  <noscript><p class="mb-4 rounded-xl bg-brand-soft p-3 text-sm">This calculator needs JavaScript. The article below lists the formulas, so you can work out any percent by hand.</p></noscript>
  <!-- Phone: inputs, each followed by its answer, then the chart. Desktop: inputs on the left, the chart on the right. -->
  <div class="flex flex-col gap-8 md:grid md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:items-start md:gap-x-8">

    <div class="space-y-6">
      <fieldset>
        <legend class="mb-2 text-sm font-semibold">Units</legend>
        <div class="grid grid-cols-2 gap-2" id="unit-group">
          <label class="seg"><input type="radio" name="unit" value="lb" class="peer sr-only" checked /><span class="seg-face">Pounds (lb)</span></label>
          <label class="seg"><input type="radio" name="unit" value="kg" class="peer sr-only" /><span class="seg-face">Kilograms (kg)</span></label>
        </div>
      </fieldset>

      <div>
        <label for="onerm" class="mb-2 block text-sm font-semibold">Your 1RM <span id="unit-label" class="font-normal text-muted">(lb)</span></label>
        <div class="flex items-stretch gap-2">
          <button type="button" id="dec" class="step" aria-label="Subtract one step from your 1RM">&minus;</button>
          <input id="onerm" type="text" inputmode="decimal" autocomplete="off" enterkeyhint="done" value="225" aria-describedby="note-onerm"
            class={`${numberBox} h-14 min-w-0 flex-1 text-3xl`} />
          <button type="button" id="inc" class="step" aria-label="Add one step to your 1RM">+</button>
        </div>
        <p id="note-onerm" class="note" role="status"></p>
        <div id="chips" class="mt-1 flex flex-wrap gap-2" role="group" aria-label="Common 1RM values"></div>
      </div>

      <div>
        <label for="pct" class="mb-2 block text-sm font-semibold">Your percent</label>
        <div class="flex items-center gap-2">
          <input id="pct" type="text" inputmode="decimal" autocomplete="off" enterkeyhint="done" value="85" aria-describedby="note-pct res-pct-text"
            class={`${numberBox} h-12 w-28 text-xl`} />
          <span class="text-lg font-semibold" aria-hidden="true">%</span>
        </div>
        <p id="note-pct" class="note" role="status"></p>
        <div id="pct-chips" class="mt-1 flex flex-wrap gap-2" role="group" aria-label="Common percents">
          {[70, 75, 80, 85, 90, 95].map((p) => <button type="button" class="chip" data-p={p} aria-pressed={p === 85 ? 'true' : 'false'}>{p}%</button>)}
        </div>
        <div class="result min-h-[8.5rem]" id="result-pct">
          <p id="res-pct-big" class="min-h-[2.5rem] font-mono text-4xl font-bold tabular-nums"></p>
          <p id="res-pct-text" role="status" aria-live="polite" class="mt-1 min-h-[3.25rem] text-base font-medium"></p>
        </div>
      </div>

      <div>
        <label for="wt" class="mb-2 block text-sm font-semibold">Find the percent of a weight <span id="wt-unit" class="font-normal text-muted">(lb)</span></label>
        <input id="wt" type="text" inputmode="decimal" autocomplete="off" enterkeyhint="done" value="185" aria-describedby="note-wt res-rev-text"
          class={`${numberBox} h-12 w-40 text-xl`} />
        <p id="note-wt" class="note" role="status"></p>
        <div class="result min-h-[5.5rem]" id="result-rev">
          <p id="res-rev-text" role="status" aria-live="polite" class="text-base font-medium"></p>
        </div>
      </div>

      <details class="more" id="more">
        <summary>Bar and plates</summary>
        <div class="mt-3 space-y-5">
          <fieldset>
            <legend class="mb-2 text-sm font-semibold">Bar</legend>
            <div class="flex flex-wrap gap-2" id="bar-group"></div>
            <div id="custom-bar-wrap" class="mt-2 hidden items-center gap-2">
              <label for="custom-bar" class="text-sm text-muted">Bar weight</label>
              <input id="custom-bar" type="text" inputmode="decimal" autocomplete="off" value="25" aria-describedby="note-bar"
                class={`${numberBox} h-12 w-28 text-lg`} />
              <span id="custom-bar-unit" class="text-sm text-muted">lb</span>
            </div>
            <p id="note-bar" class="note" role="status"></p>
          </fieldset>
          <fieldset>
            <legend class="mb-1 text-sm font-semibold">Plates you have</legend>
            <p class="mb-2 text-sm text-muted">Tick every plate size your gym has. Weights round to loads these plates can make. 35 lb, 1.25 lb and 0.5 kg start unticked.</p>
            <div class="flex flex-wrap gap-2" id="plate-group">
              {PLATES.lb.map((w) => <label class="seg"><input type="checkbox" name="plate" value={w} class="peer sr-only" checked={DEFAULT_PLATES.lb.includes(w)} /><span class="seg-face seg-sm">{w}</span></label>)}
            </div>
            <p id="note-plates" class="note" role="status"></p>
          </fieldset>
        </div>
      </details>
    </div>

    <div class="min-w-0">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 class="text-lg font-bold" id="chart-h">Percent of 1RM chart</h2>
        <fieldset class="m-0 border-0 p-0">
          <legend class="sr-only">Chart step</legend>
          <div class="flex gap-2" id="step-group">
            <label class="seg"><input type="radio" name="step" value="10" class="peer sr-only" /><span class="seg-face seg-sm">10%</span></label>
            <label class="seg"><input type="radio" name="step" value="5" class="peer sr-only" checked /><span class="seg-face seg-sm">5%</span></label>
            <label class="seg"><input type="radio" name="step" value="2.5" class="peer sr-only" /><span class="seg-face seg-sm">2.5%</span></label>
          </div>
        </fieldset>
      </div>
      <div class="mt-3 overflow-x-auto rounded-xl border border-line">
        <table class="tbl w-full min-w-[19rem] text-left text-sm">
          <caption class="sr-only">Percent of your 1RM, from 100 percent down to 50 percent: exact weight, loadable weight and plates on each side</caption>
          <thead class="bg-brand-soft text-xs uppercase tracking-wide text-brand-ink">
            <tr><th scope="col" class="px-3 py-2 font-semibold">%</th><th scope="col" class="px-3 py-2 font-semibold">Exact</th><th scope="col" class="px-3 py-2 font-semibold">Load</th><th scope="col" class="px-3 py-2 font-semibold">Each side</th></tr>
          </thead>
          <tbody id="chart-body" class="divide-y divide-line" set:html={startChart}></tbody>
        </table>
      </div>
      <p id="chart-note" class="mt-2 min-h-[2.5rem] text-xs text-muted"></p>
    </div>
  </div>

  <h2 class="mt-8 text-lg font-bold" id="rep-h">Rep max estimates</h2>
  <p class="mt-1 text-sm text-muted">Estimates, not promises. Each cell is the weight you could likely lift for that many reps, from the Epley and Brzycki formulas, rounded to a load the bar can make. Plates are for each side of the bar. Accuracy drops above 10 reps.</p>
  <div class="mt-3 overflow-x-auto rounded-xl border border-line">
    <table class="tbl w-full min-w-[19rem] text-left text-sm">
      <caption class="sr-only">Estimated weight for 1 to 12 reps, by Epley and by Brzycki, as a share of your 1RM</caption>
      <thead class="bg-brand-soft text-xs uppercase tracking-wide text-brand-ink">
        <tr><th scope="col" class="px-3 py-2 font-semibold">Reps</th><th scope="col" class="px-3 py-2 font-semibold">Epley</th><th scope="col" class="px-3 py-2 font-semibold">Brzycki</th></tr>
      </thead>
      <tbody id="rep-body" class="divide-y divide-line" set:html={startReps}></tbody>
    </table>
  </div>
</section>

<style is:global>
  .seg-face { display:flex; min-height:3rem; align-items:center; justify-content:center; border-radius:.75rem; border:1px solid var(--edge); background:var(--paper); padding:.5rem .9rem; font-weight:600; font-size:.95rem; cursor:pointer; text-align:center; transition:background-color .12s,border-color .12s; user-select:none; font-variant-numeric:tabular-nums; }
  .seg-face.seg-sm { min-height:2.75rem; min-width:3.5rem; padding:.35rem .8rem; }
  .seg-face:hover { border-color: var(--brand); }
  .peer:checked + .seg-face { background: var(--brand); border-color: var(--brand); color:#fff; }
  .peer:checked + .seg-face::before { content: "\2713\00a0"; }
  .peer:focus-visible + .seg-face { outline:2px solid var(--brand-ink); outline-offset:2px; }
  .step { width:3.5rem; flex:none; border-radius:.75rem; border:1px solid var(--edge); background:var(--paper); font-size:1.75rem; font-weight:600; line-height:1; cursor:pointer; }
  .step:hover { border-color: var(--brand); }
  .step:active { background: var(--brand-soft); }
  .chip { min-height:2.75rem; min-width:3.25rem; padding:.25rem .75rem; border-radius:999px; border:1px solid var(--edge); background:var(--paper); font-weight:600; font-size:.9rem; font-variant-numeric:tabular-nums; cursor:pointer; }
  .chip:hover { border-color: var(--brand); }
  .chip[aria-pressed="true"] { background: var(--brand); border-color: var(--brand); color:#fff; }
  .chip[aria-pressed="true"]::before { content: "\2713\00a0"; }
  .tbl td, .tbl th { vertical-align: top; }
  .tbl tbody tr.hit { background: var(--brand-soft); }
  .tbl .load { font-family: var(--font-mono); font-weight: 700; font-size: 1rem; white-space: nowrap; }
  .result { border-radius:.75rem; background: var(--brand-soft); padding:1rem; margin-top:.75rem; }
  .note:empty { display:none; }
  .note { margin-top:.375rem; font-size:.875rem; color: var(--muted); }
  details.more > summary { display:flex; min-height:2.75rem; align-items:center; cursor:pointer; font-size:.875rem; font-weight:600; }
  .tbl .sub { display:block; font-size:.75rem; color:var(--muted); font-variant-numeric:tabular-nums; }
</style>
<script>
  import { PLATES, DEFAULT_PLATES, BARS, MAX_WEIGHT, smallestOf, chart, repTable, row, repEstimateText, percentFromWeight, describeSide, convertTarget, convertWeight, readField, parseBar, fmt, fmt1 } from '../lib/percent.js';
  import { chartRowsHtml, repRowsHtml } from '../lib/render.js';

  type Unit = 'lb' | 'kg';
  // Smallest 1RM or weight the page accepts. Anything below 1 is not a real lift and gives silly percents.
  const MIN_WEIGHT = 1;
  const QUICK: Record<Unit, number[]> = { lb: [135, 185, 225, 275, 315, 405], kg: [60, 80, 100, 120, 140, 180] };
  const STEP: Record<Unit, number> = { lb: 5, kg: 2.5 };
  const DEFAULT_CUSTOM: Record<Unit, number> = { lb: 25, kg: 10 };
  const KEY = 'pct1rm-v2';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const isWeight = (x: unknown): x is number => typeof x === 'number' && Number.isFinite(x) && x >= 0 && x <= MAX_WEIGHT;

  const state = {
    unit: 'lb' as Unit,
    oneRm: 225,
    pct: 85,
    wt: 185,
    chartStep: 5,
    bar: { lb: '45', kg: '20' } as Record<Unit, string>,
    customBar: { ...DEFAULT_CUSTOM } as Record<Unit, number>,
    plates: { lb: [...DEFAULT_PLATES.lb], kg: [...DEFAULT_PLATES.kg] } as Record<Unit, number[]>,
  };

  try {
    const s = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (s && typeof s === 'object') {
      if (s.unit === 'lb' || s.unit === 'kg') state.unit = s.unit;
      if (isWeight(s.oneRm) && s.oneRm >= MIN_WEIGHT) state.oneRm = s.oneRm;
      if (isWeight(s.pct) && s.pct <= 200) state.pct = s.pct;
      if (isWeight(s.wt) && (s.wt === 0 || s.wt >= MIN_WEIGHT)) state.wt = s.wt;
      if ([10, 5, 2.5].includes(s.chartStep)) state.chartStep = s.chartStep;
      for (const u of ['lb', 'kg'] as Unit[]) {
        if (s.bar && typeof s.bar[u] === 'string' && (s.bar[u] === 'custom' || (BARS[u] as number[]).map(String).includes(s.bar[u]))) state.bar[u] = s.bar[u];
        if (s.customBar && isWeight(s.customBar[u]) && s.customBar[u] > 0) state.customBar[u] = s.customBar[u];
        const saved = s.plates && Array.isArray(s.plates[u]) ? (PLATES[u] as number[]).filter((p) => s.plates[u].includes(p)) : [];
        if (saved.length) state.plates[u] = saved;
      }
    }
  } catch {}
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {} };

  // The last 1RM the person typed, so a unit round trip returns to it (225 lb, 102.5 kg, 225 lb).
  let anchor = { unit: state.unit, oneRm: state.oneRm };

  // A custom bar that is blank, 0 or text is NaN: the page asks for a bar weight instead of using a bad one.
  const barWeight = () => { const id = state.bar[state.unit]; return id === 'custom' ? state.customBar[state.unit] : Number(id); };
  const show = (id: string, on: boolean) => { $(id).classList.toggle('hidden', !on); $(id).classList.toggle('flex', on); };
  const note = (id: string, text = '') => { $('note-' + id).textContent = text; };
  const fmtMax = fmt(MAX_WEIGHT).replace(/\B(?=(\d{3})+(?!\d))/g, ',');

  function buildStatic() {
    const u = state.unit;
    (document.querySelector(`input[name=unit][value=${u}]`) as HTMLInputElement).checked = true;
    (document.querySelector(`input[name=step][value="${state.chartStep}"]`) as HTMLInputElement).checked = true;
    $('unit-label').textContent = `(${u})`;
    $('wt-unit').textContent = `(${u})`;
    $('custom-bar-unit').textContent = u;
    $<HTMLInputElement>('onerm').value = fmt(state.oneRm);
    $<HTMLInputElement>('pct').value = fmt(state.pct);
    $<HTMLInputElement>('wt').value = state.wt > 0 ? fmt(state.wt) : '';
    $<HTMLInputElement>('custom-bar').value = fmt(state.customBar[u]);
    $('chips').innerHTML = QUICK[u].map((w) => `<button type="button" class="chip" data-w="${w}">${w}</button>`).join('');
    const bars = [
      ...(BARS[u] as number[]).map((w, i) => ({ id: String(w), label: `${i === 0 ? 'Standard' : 'Women’s'} ${w} ${u}` })),
      { id: 'custom', label: 'Custom' },
    ];
    $('bar-group').innerHTML = bars.map((b) =>
      `<label class="seg"><input type="radio" name="bar" value="${b.id}" class="peer sr-only"${b.id === state.bar[u] ? ' checked' : ''} /><span class="seg-face">${b.label}</span></label>`).join('');
    show('custom-bar-wrap', state.bar[u] === 'custom');
    $('plate-group').innerHTML = (PLATES[u] as number[]).map((w) =>
      `<label class="seg"><input type="checkbox" name="plate" value="${w}" class="peer sr-only"${state.plates[u].includes(w) ? ' checked' : ''} /><span class="seg-face seg-sm">${fmt(w)}</span></label>`).join('');
    for (const id of ['onerm', 'pct', 'wt', 'bar', 'plates']) note(id);
    ['onerm', 'pct', 'wt', 'custom-bar'].forEach((id) => $(id).removeAttribute('aria-invalid'));
  }

  function render() {
    const u = state.unit;
    const bar = barWeight();
    const plates = state.plates[u];
    const smallest = smallestOf(plates);
    const oneRm = state.oneRm;

    const bigEl = $('res-pct-big'), textEl = $('res-pct-text'), revEl = $('res-rev-text');

    // Show which quick chips match the current numbers.
    document.querySelectorAll<HTMLElement>('#chips .chip').forEach((c) => c.setAttribute('aria-pressed', String(Number(c.dataset.w) === state.oneRm)));
    document.querySelectorAll<HTMLElement>('#pct-chips .chip').forEach((c) => c.setAttribute('aria-pressed', String(Number(c.dataset.p) === state.pct)));

    const bad = !(oneRm > 0) || !(bar > 0) || bar > MAX_WEIGHT;
    if (bad) {
      bigEl.textContent = 'Enter a number';
      textEl.textContent = !(oneRm > 0) ? `Enter your 1RM, ${MIN_WEIGHT} or more, to see the weights.` : 'Enter the bar weight to see the plates.';
      revEl.textContent = '';
      $('chart-body').innerHTML = '';
      $('rep-body').innerHTML = '';
      $('chart-note').textContent = '';
      save();
      return;
    }

    // Own percent
    if (state.pct > 0) {
      const r = row({ oneRm, pct: state.pct, bar, smallest, plates });
      bigEl.textContent = `${fmt(r.load)} ${u}`;
      const sideTxt = r.below || r.load <= bar ? 'That is under the bar, so the bar alone is the lightest load.'
        : r.side ? `Each side: ${describeSide(r.side)}.` : 'Your plates cannot make this load.';
      textEl.textContent = `${fmt1(state.pct)}% of your 1RM is ${fmt(+r.exact.toFixed(2))} ${u} exactly, rounded to a load your plates can make. ${sideTxt}`;
    } else {
      bigEl.textContent = '-';
      textEl.textContent = 'Enter a percent above 0.';
    }

    // Weight to percent
    if (state.wt > 0) {
      const p = percentFromWeight(oneRm, state.wt);
      const base = `${fmt(state.wt)} ${u} is ${fmt1(p)}% of your ${fmt(oneRm)} ${u} 1RM.`;
      if (p > 1000) revEl.textContent = `${fmt(state.wt)} ${u} is more than 10 times your ${fmt(oneRm)} ${u} 1RM. Check both numbers.`;
      else if (p < 1) revEl.textContent = `${fmt(state.wt)} ${u} is less than 1% of your ${fmt(oneRm)} ${u} 1RM.`;
      else revEl.textContent = p > 100 ? `${base} That is above your 1RM. Update your 1RM if you lifted it.` : `${base} ${repEstimateText(p / 100)}`.trim();
    } else revEl.textContent = 'Enter a weight to see its percent of your 1RM.';

    // Chart and rep table
    const rows = chart({ oneRm, step: state.chartStep, bar, smallest, plates });
    $('chart-body').innerHTML = chartRowsHtml(rows, bar, state.pct);
    const notes: string[] = [];
    if (rows.some((r) => r.below)) notes.push('A row under the bar weight shows the bar, the lightest load possible.');
    if (rows[0].pct === 100 && rows[0].load > oneRm + 1e-9) notes.push('The 100% row rounds to a load the bar can make, so it sits above your 1RM. Use the next load down to stay under it.');
    $('chart-note').textContent = notes.join(' ');
    $('rep-body').innerHTML = repRowsHtml(repTable({ oneRm, bar, smallest, plates }), bar);
    save();
  }

  function setOneRm(v: number) {
    if (!(v > 0)) return;
    state.oneRm = Math.min(v, MAX_WEIGHT);
    anchor = { unit: state.unit, oneRm: state.oneRm };
    $<HTMLInputElement>('onerm').value = fmt(state.oneRm);
    $('onerm').removeAttribute('aria-invalid');
    note('onerm');
    render();
  }
  const nudge = (dir: 1 | -1) => setOneRm(Math.max(STEP[state.unit], (state.oneRm || 0) + dir * STEP[state.unit]));

  // Number fields: bad text shows the invalid state and a message; blur puts the used value back.
  function numberField(id: string, get: () => number, set: (v: number) => void, max: number, min = 0) {
    const el = $<HTMLInputElement>(id);
    el.addEventListener('input', () => {
      const f = readField(el.value, max);
      const tooSmall = !f.bad && f.value > 0 && f.value < min;
      el.setAttribute('aria-invalid', String(f.bad || f.clamped || tooSmall));
      note(id, f.bad ? 'Use numbers only, like 225 or 102.5.' : tooSmall ? `The smallest value is ${min}.` : f.clamped ? `The largest value is ${max === MAX_WEIGHT ? fmtMax : max}.` : '');
      set(tooSmall ? 0 : f.value);
      if (f.clamped) el.value = fmt(max);
      render();
    });
    el.addEventListener('blur', () => { if (get() > 0) { el.value = fmt(get()); el.removeAttribute('aria-invalid'); note(id); } });
  }
  numberField('onerm', () => state.oneRm, (v) => { state.oneRm = v; anchor = { unit: state.unit, oneRm: v }; }, MAX_WEIGHT, MIN_WEIGHT);
  numberField('pct', () => state.pct, (v) => { state.pct = v; }, 200);
  numberField('wt', () => state.wt, (v) => { state.wt = v; }, MAX_WEIGHT, MIN_WEIGHT);
  // Custom bar: a blank, zero or bad value must not hide behind an old one. It asks for a bar weight.
  {
    const el = $<HTMLInputElement>('custom-bar');
    el.addEventListener('input', () => {
      state.customBar[state.unit] = parseBar(el.value);
      const ok = state.customBar[state.unit] > 0;
      el.setAttribute('aria-invalid', String(!ok));
      note('bar', ok ? '' : `Enter a bar weight above 0 and up to ${fmtMax}.`);
      render();
    });
    el.addEventListener('blur', () => {
      if (!(state.customBar[state.unit] > 0)) { state.customBar[state.unit] = DEFAULT_CUSTOM[state.unit]; render(); }
      el.value = fmt(state.customBar[state.unit]);
      el.removeAttribute('aria-invalid');
      note('bar');
    });
  }

  $('onerm').addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'ArrowUp') { e.preventDefault(); nudge(1); }
    if ((e as KeyboardEvent).key === 'ArrowDown') { e.preventDefault(); nudge(-1); }
  });
  $('inc').addEventListener('click', () => nudge(1));
  $('dec').addEventListener('click', () => nudge(-1));
  $('chips').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button[data-w]') as HTMLElement | null;
    if (b) setOneRm(Number(b.dataset.w));
  });
  $('pct-chips').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button[data-p]') as HTMLElement | null;
    if (!b) return;
    state.pct = Number(b.dataset.p);
    $<HTMLInputElement>('pct').value = fmt(state.pct);
    $('pct').removeAttribute('aria-invalid');
    note('pct');
    render();
  });
  $('unit-group').addEventListener('change', (e) => {
    const to = (e.target as HTMLInputElement).value as Unit;
    if (to === state.unit) return;
    state.oneRm = anchor.unit === to && anchor.oneRm > 0 ? anchor.oneRm : convertTarget(state.oneRm, state.unit, to);
    if (state.wt > 0) state.wt = Math.max(MIN_WEIGHT, Math.round(convertWeight(state.wt, state.unit, to) * 2) / 2);
    state.unit = to;
    buildStatic(); render();
  });
  $('step-group').addEventListener('change', (e) => { state.chartStep = Number((e.target as HTMLInputElement).value); render(); });
  $('bar-group').addEventListener('change', (e) => {
    state.bar[state.unit] = (e.target as HTMLInputElement).value;
    show('custom-bar-wrap', state.bar[state.unit] === 'custom');
    note('bar');
    render();
  });
  $('plate-group').addEventListener('change', (e) => {
    const box = e.target as HTMLInputElement;
    const u = state.unit;
    const next = (PLATES[u] as number[]).filter((p) => (p === Number(box.value) ? box.checked : state.plates[u].includes(p)));
    if (!next.length) { box.checked = true; note('plates', 'Keep at least one plate ticked.'); return; }
    note('plates');
    state.plates[u] = next;
    render();
  });

  buildStatic();
  render();
</script>
