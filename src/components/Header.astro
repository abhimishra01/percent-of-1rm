---
import { url } from '../lib/url.ts';
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
const links = [
  { href: url(), label: 'Tool' },
  { href: url('about/'), label: 'About' },
  { href: url('contact/'), label: 'Contact' },
];
---
<header class="sticky top-0 z-20 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4">
    <a href={url()} class="flex min-h-[44px] items-center gap-2.5 font-bold tracking-tight text-ink no-underline">
      <img src={url('favicon.svg')} alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
      <span class="leading-none">Percent of 1RM<span class="hidden font-medium text-muted sm:inline"> Calculator</span></span>
    </a>
    <div class="flex items-center gap-1">
      <nav aria-label="Main" class="flex items-center">
        {links.map((l) => (
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined}
            class="rounded-full px-3 py-3 text-sm font-medium text-muted no-underline hover:text-ink aria-[current=page]:text-ink aria-[current=page]:bg-brand-soft max-[420px]:px-2">{l.label}</a>
        ))}
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
