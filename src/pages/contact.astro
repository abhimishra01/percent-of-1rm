---
import Page from '../layouts/Page.astro';
import site from '../site.config.ts';
---
<Page title="Contact" description={`Contact ${site.name}.`}>
  <p>Found a bug or a wrong number? Have an idea? Send us a message and we will read it.</p>
  <p><a href={site.contactHref}>{site.contactLabel}</a></p>
  <p>Please include your device, your browser and the weight you entered. That helps us find the problem fast.</p>
</Page>
